@Article{Ramm:2013ft,
author = {Ramm, Steven A and Jonker, Rudy M and Reinhold, Klaus and Székely, Tamás and Trillmich, Fritz and Schmoll, Tim and Schielzeth, Holger and Freckleton, Robert P}, 
title = {Comment on ``Bateman in nature: predation on offspring reduces the potential for sexual selection''}, 
journal = {Science}, 
